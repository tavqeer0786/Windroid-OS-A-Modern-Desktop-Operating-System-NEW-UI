[Unit]
Description=Windroid OS First Boot OOBE Readiness Service
After=local-fs.target network.target windroid-bridge.service
Before=lightdm.service display-manager.service
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /usr/bin/windroid-first-boot.py

[Install]
WantedBy=graphical.target
